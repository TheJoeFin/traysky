<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Traysky.Pages.GroupInfoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:Traysky.Helpers"
    xmlns:items="using:Traysky.ViewModels.Items"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <ListView
            x:Name="MemberList"
            IsItemClickEnabled="True"
            ItemClick="MemberList_ItemClick"
            ItemsSource="{x:Bind ViewModel.Members}"
            SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.Header>
                <StackPanel>
                    <Grid Margin="12,12,12,8" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="{x:Bind ViewModel.Name, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Style="{StaticResource SecondaryTextStyle}"
                                Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Top"
                            Command="{x:Bind ViewModel.RenameGroupCommand}"
                            ToolTipService.ToolTip="Rename group"
                            Visibility="{x:Bind ViewModel.CanRename, Mode=OneWay}">
                            <FontIcon FontSize="14" Glyph="&#xE70F;" />
                        </Button>
                    </Grid>

                    <InfoBar
                        Margin="12,0,12,8"
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.IsLocked, Mode=OneWay}"
                        Message="This group is locked. Nobody can send new messages."
                        Severity="Informational" />
                    <InfoBar
                        Margin="12,0,12,8"
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                        Message="{x:Bind ViewModel.Error, Mode=OneWay}"
                        Severity="Warning" />

                    <!--  Owner only: join link and the requests it collects.  -->
                    <StackPanel
                        Margin="12,0,12,8"
                        Spacing="6"
                        Visibility="{x:Bind ViewModel.CanManageLink, Mode=OneWay}">
                        <ToggleSwitch
                            Header="Join link"
                            IsOn="{x:Bind ViewModel.LinkEnabled, Mode=TwoWay}"
                            OffContent="Off"
                            OnContent="On" />
                        <TextBlock
                            Style="{StaticResource SecondaryTextStyle}"
                            Text="{x:Bind ViewModel.LinkSummary, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8"
                            Visibility="{x:Bind ViewModel.ShowLinkCode, Mode=OneWay}">
                            <TextBlock
                                VerticalAlignment="Center"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind ViewModel.LinkCode, Mode=OneWay}" />
                            <Button Click="CopyCode_Click" Content="Copy code" />
                        </StackPanel>
                        <ToggleSwitch
                            Header="Approve each person"
                            IsEnabled="{x:Bind ViewModel.HasLink, Mode=OneWay}"
                            IsOn="{x:Bind ViewModel.LinkRequireApproval, Mode=TwoWay}"
                            OffContent="Anyone can join right away"
                            OnContent="Joining needs my approval" />
                        <ToggleSwitch
                            Header="Who can use the link"
                            IsEnabled="{x:Bind ViewModel.HasLink, Mode=OneWay}"
                            IsOn="{x:Bind ViewModel.LinkFollowedOnly, Mode=TwoWay}"
                            OffContent="Anyone"
                            OnContent="Only people I follow" />

                        <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.HasRequests, Mode=OneWay}">
                            <TextBlock
                                Margin="0,6,0,0"
                                FontWeight="SemiBold"
                                Text="Waiting to join" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Requests}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="items:ActorItem">
                                        <Grid Padding="0,4" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <PersonPicture
                                                Width="28"
                                                Height="28"
                                                DisplayName="{x:Bind NameOrHandle}"
                                                ProfilePicture="{x:Bind helpers:BindHelpers.ImageFromUri(AvatarUri)}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Text="{x:Bind NameOrHandle}"
                                                TextTrimming="CharacterEllipsis" />
                                            <Button
                                                Grid.Column="2"
                                                Click="Approve_Click"
                                                Content="Approve"
                                                Style="{StaticResource AccentButtonStyle}" />
                                            <Button
                                                Grid.Column="3"
                                                Click="Decline_Click"
                                                Content="Decline" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>

                    <Button
                        Margin="12,0,12,8"
                        Command="{x:Bind ViewModel.AddPeopleCommand}"
                        Visibility="{x:Bind ViewModel.CanAddMembers, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE710;" />
                            <TextBlock Text="Add people" />
                        </StackPanel>
                    </Button>

                    <TextBlock
                        Margin="12,4,12,6"
                        FontWeight="SemiBold"
                        Text="Members" />
                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                </StackPanel>
            </ListView.Header>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="items:ActorItem">
                    <Grid Padding="12,8" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PersonPicture
                            Width="{StaticResource AvatarSize}"
                            Height="{StaticResource AvatarSize}"
                            DisplayName="{x:Bind NameOrHandle}"
                            ProfilePicture="{x:Bind helpers:BindHelpers.ImageFromUri(AvatarUri)}" />
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="1">
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="{x:Bind NameOrHandle}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Style="{StaticResource SecondaryTextStyle}"
                                Text="{x:Bind HandleDisplay}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Style="{StaticResource SecondaryTextStyle}"
                                Text="{x:Bind ManagedDetail}"
                                Visibility="{x:Bind helpers:BindHelpers.VisibleIf(HasManagedDetail)}" />
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Click="Remove_Click"
                            Content="{x:Bind ManagedActionLabel}"
                            Visibility="{x:Bind helpers:BindHelpers.VisibleIf(HasManagedAction)}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>

            <ListView.Footer>
                <Grid Height="40">
                    <ProgressRing
                        Width="20"
                        Height="20"
                        IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                </Grid>
            </ListView.Footer>
        </ListView>
    </Grid>
</Page>
