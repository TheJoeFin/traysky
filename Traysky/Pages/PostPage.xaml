<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Traysky.Pages.PostPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Traysky.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:Traysky.Helpers"
    xmlns:items="using:Traysky.ViewModels.Items"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  "Barry Dorrans liked this post"  -->
        <Grid
            Grid.Row="0"
            Margin="12,4,12,6"
            Padding="10,6"
            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
            ColumnSpacing="8"
            CornerRadius="8"
            Visibility="{x:Bind ViewModel.HasContext, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon
                FontSize="12"
                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                Glyph="&#xEA8F;" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="12"
                Text="{x:Bind ViewModel.Context, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap" />
        </Grid>

        <ListView
            x:Name="ThreadList"
            Grid.Row="1"
            IsItemClickEnabled="False"
            ItemsSource="{x:Bind ViewModel.Rows}"
            SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="items:ThreadRow">
                    <Grid Background="{x:Bind helpers:BindHelpers.MainPostBackground(IsMain)}" Padding="{x:Bind Indent}">
                        <controls:PostCard
                            IsOpenable="{x:Bind helpers:BindHelpers.Not(IsMain)}"
                            Post="{x:Bind Post}"
                            ThreadRequested="PostCard_ThreadRequested" />
                        <Rectangle
                            Height="1"
                            VerticalAlignment="Bottom"
                            Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.Footer>
                <StackPanel Margin="12,8" Spacing="8">
                    <ProgressRing
                        Width="20"
                        Height="20"
                        HorizontalAlignment="Center"
                        IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource SecondaryTextStyle}"
                        Text="No replies yet"
                        Visibility="{x:Bind ViewModel.HasNoReplies, Mode=OneWay}" />
                    <InfoBar
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                        Message="{x:Bind ViewModel.Error, Mode=OneWay}"
                        Severity="Warning">
                        <InfoBar.ActionButton>
                            <Button Command="{x:Bind ViewModel.RetryCommand}" Content="Retry" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                    <HyperlinkButton
                        HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.OpenInBrowserCommand}"
                        Content="Open on bsky.app" />
                </StackPanel>
            </ListView.Footer>
        </ListView>
    </Grid>
</Page>
