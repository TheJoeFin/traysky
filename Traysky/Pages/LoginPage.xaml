<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Traysky.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            Margin="20,8,20,20"
            MaxWidth="320"
            Spacing="12">

            <Image
                Width="56"
                Height="56"
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                Source="ms-appx:///Assets/Wings-Dark.png" />

            <TextBlock
                HorizontalAlignment="Center"
                FontSize="20"
                FontWeight="SemiBold"
                Text="Sign in to Bluesky" />

            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource SecondaryTextStyle}"
                Text="Your timeline and notifications, one click from the tray."
                TextAlignment="Center"
                TextWrapping="Wrap" />

            <TextBox
                x:Name="HandleBox"
                Header="Handle"
                IsEnabled="{x:Bind IsNotBusy(ViewModel.IsBusy), Mode=OneWay}"
                IsSpellCheckEnabled="False"
                KeyDown="Field_KeyDown"
                PlaceholderText="alice.bsky.social"
                Text="{x:Bind ViewModel.Handle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <PasswordBox
                x:Name="PasswordBox"
                Header="App password"
                IsEnabled="{x:Bind IsNotBusy(ViewModel.IsBusy), Mode=OneWay}"
                KeyDown="Field_KeyDown"
                Password="{x:Bind ViewModel.AppPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                PlaceholderText="xxxx-xxxx-xxxx-xxxx" />

            <TextBox
                x:Name="AuthCodeBox"
                Header="Email sign-in code"
                IsEnabled="{x:Bind IsNotBusy(ViewModel.IsBusy), Mode=OneWay}"
                KeyDown="Field_KeyDown"
                PlaceholderText="XXXXX-XXXXX"
                Text="{x:Bind ViewModel.AuthCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Visibility="{x:Bind ViewModel.NeedsAuthCode, Mode=OneWay}" />

            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.Error, Mode=OneWay}"
                Severity="Error" />

            <Button
                HorizontalAlignment="Stretch"
                Command="{x:Bind ViewModel.SignInCommand}"
                Style="{StaticResource AccentButtonStyle}">
                <Grid>
                    <TextBlock Text="Sign in" Visibility="{x:Bind HiddenWhenBusy(ViewModel.IsBusy), Mode=OneWay}" />
                    <ProgressRing
                        Width="18"
                        Height="18"
                        IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                </Grid>
            </Button>

            <StackPanel Spacing="4">
                <TextBlock
                    Style="{StaticResource SecondaryTextStyle}"
                    Text="Use an app password, not your account password. App passwords can be revoked any time and skip two-factor prompts."
                    TextWrapping="Wrap" />
                <HyperlinkButton
                    Padding="0"
                    Command="{x:Bind ViewModel.OpenAppPasswordsCommand}"
                    Content="Create an app password on bsky.app" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
