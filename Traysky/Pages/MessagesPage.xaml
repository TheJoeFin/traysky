<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Traysky.Pages.MessagesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:Traysky.Helpers"
    xmlns:items="using:Traysky.ViewModels.Items"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <Grid>
        <ListView
            x:Name="ConversationList"
            IsItemClickEnabled="True"
            ItemClick="ConversationList_ItemClick"
            ItemsSource="{x:Bind ViewModel.Items}"
            SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.Header>
                <TextBlock
                    Margin="12,4,12,8"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Text="Messages" />
            </ListView.Header>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="items:ConversationItem">
                    <Grid
                        Padding="12,10"
                        Background="{x:Bind helpers:BindHelpers.UnreadBackground(IsUnread), Mode=OneWay}"
                        ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <PersonPicture
                            Width="{StaticResource AvatarSize}"
                            Height="{StaticResource AvatarSize}"
                            VerticalAlignment="Top"
                            DisplayName="{x:Bind Title}"
                            ProfilePicture="{x:Bind helpers:BindHelpers.ImageFromUri(AvatarUri)}" />

                        <StackPanel Grid.Column="1" Spacing="1">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="{x:Bind Title}"
                                    TextTrimming="CharacterEllipsis" />
                                <Border
                                    Padding="6,1"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="4"
                                    Visibility="{x:Bind IsRequest, Mode=OneWay}">
                                    <TextBlock FontSize="11" Text="Request" />
                                </Border>
                                <FontIcon
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xE74F;"
                                    ToolTipService.ToolTip="Muted"
                                    Visibility="{x:Bind IsMuted}" />
                            </StackPanel>
                            <TextBlock
                                MaxLines="2"
                                Style="{StaticResource SecondaryTextStyle}"
                                Text="{x:Bind LastMessagePreview, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            Spacing="6">
                            <TextBlock
                                HorizontalAlignment="Right"
                                Style="{StaticResource SecondaryTextStyle}"
                                Text="{x:Bind TimeAgo, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind AbsoluteTime, Mode=OneWay}" />
                            <InfoBadge
                                HorizontalAlignment="Right"
                                Style="{StaticResource AttentionValueInfoBadgeStyle}"
                                Value="{x:Bind helpers:BindHelpers.BadgeValue(UnreadCount), Mode=OneWay}"
                                Visibility="{x:Bind IsUnread, Mode=OneWay}" />
                        </StackPanel>

                        <Rectangle
                            Grid.ColumnSpan="3"
                            Height="1"
                            Margin="-12,0,-12,-10"
                            VerticalAlignment="Bottom"
                            Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.Footer>
                <Grid Height="40">
                    <ProgressRing
                        Width="20"
                        Height="20"
                        IsActive="{x:Bind ViewModel.IsLoadingMore, Mode=OneWay}" />
                </Grid>
            </ListView.Footer>
        </ListView>

        <ProgressRing
            Width="32"
            Height="32"
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

        <StackPanel
            MaxWidth="240"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
            <FontIcon
                FontSize="28"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="&#xE8BD;" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource SecondaryTextStyle}"
                Text="No conversations yet. Start one with the Message button on someone's profile."
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>

        <InfoBar
            Margin="12"
            VerticalAlignment="Top"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.Error, Mode=OneWay}"
            Severity="Warning">
            <InfoBar.ActionButton>
                <Button Command="{x:Bind ViewModel.RefreshCommand}" Content="Retry" />
            </InfoBar.ActionButton>
        </InfoBar>
    </Grid>
</Page>
