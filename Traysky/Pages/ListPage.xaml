<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Traysky.Pages.ListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:Traysky.Helpers"
    xmlns:items="using:Traysky.ViewModels.Items"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <ListView
            x:Name="MemberList"
            IsItemClickEnabled="True"
            ItemClick="MemberList_ItemClick"
            ItemsSource="{x:Bind ViewModel.Members}"
            SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.Header>
                <StackPanel>
                    <Grid Margin="12,12,12,8" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="{x:Bind ViewModel.Name, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Style="{StaticResource SecondaryTextStyle}"
                                Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Margin="0,6,0,0"
                                Text="{x:Bind ViewModel.Description, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ViewModel.HasDescription, Mode=OneWay}" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Top"
                            ToolTipService.ToolTip="More"
                            Visibility="{x:Bind ViewModel.CanManage, Mode=OneWay}">
                            <FontIcon FontSize="14" Glyph="&#xE712;" />
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuFlyoutItem Command="{x:Bind ViewModel.EditListCommand}" Text="Edit list">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE70F;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Command="{x:Bind ViewModel.DeleteListCommand}" Text="Delete list">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE74D;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>

                    <StackPanel
                        Margin="12,0,12,8"
                        Spacing="6"
                        Visibility="{x:Bind ViewModel.CanMute, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                Command="{x:Bind ViewModel.ToggleMutedCommand}"
                                Content="{x:Bind ViewModel.MuteLabel, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.CanToggleSubscription, Mode=OneWay}" />
                            <Button
                                Command="{x:Bind ViewModel.BlockListCommand}"
                                Content="{x:Bind ViewModel.BlockLabel, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.CanToggleSubscription, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.CanBlock, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock
                            Style="{StaticResource SecondaryTextStyle}"
                            Text="{x:Bind ViewModel.SubscriptionStatus, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.HasSubscriptionStatus, Mode=OneWay}" />
                    </StackPanel>

                    <AutoSuggestBox
                        x:Name="AddBox"
                        Margin="12,0,12,8"
                        PlaceholderText="Add someone to this list"
                        QueryIcon="Add"
                        SuggestionChosen="AddBox_SuggestionChosen"
                        TextChanged="AddBox_TextChanged"
                        TextMemberPath="NameOrHandle"
                        Visibility="{x:Bind ViewModel.CanManage, Mode=OneWay}">
                        <AutoSuggestBox.ItemTemplate>
                            <DataTemplate x:DataType="items:ActorItem">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <PersonPicture
                                        Width="24"
                                        Height="24"
                                        DisplayName="{x:Bind NameOrHandle}"
                                        ProfilePicture="{x:Bind helpers:BindHelpers.ImageFromUri(AvatarUri)}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Text="{x:Bind NameOrHandle}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SecondaryTextStyle}"
                                        Text="{x:Bind HandleDisplay}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </AutoSuggestBox.ItemTemplate>
                    </AutoSuggestBox>

                    <InfoBar
                        Margin="12,0,12,8"
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                        Message="{x:Bind ViewModel.Error, Mode=OneWay}"
                        Severity="Warning">
                        <InfoBar.ActionButton>
                            <Button Command="{x:Bind ViewModel.RetryCommand}" Content="Retry" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                    <TextBlock
                        Margin="12,0,12,8"
                        Style="{StaticResource SecondaryTextStyle}"
                        Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                </StackPanel>
            </ListView.Header>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="items:ActorItem">
                    <Grid Padding="12,8" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PersonPicture
                            Width="{StaticResource AvatarSize}"
                            Height="{StaticResource AvatarSize}"
                            DisplayName="{x:Bind NameOrHandle}"
                            ProfilePicture="{x:Bind helpers:BindHelpers.ImageFromUri(AvatarUri)}" />
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="1">
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="{x:Bind NameOrHandle}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Style="{StaticResource SecondaryTextStyle}"
                                Text="{x:Bind HandleDisplay}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Click="Remove_Click"
                            Content="{x:Bind ManagedActionLabel}"
                            Visibility="{x:Bind helpers:BindHelpers.VisibleIf(HasManagedAction)}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>

            <ListView.Footer>
                <StackPanel Margin="12,8" Spacing="8">
                    <ProgressRing
                        Width="20"
                        Height="20"
                        HorizontalAlignment="Center"
                        IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                    <HyperlinkButton
                        HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.OpenInBrowserCommand}"
                        Content="Open on bsky.app" />
                </StackPanel>
            </ListView.Footer>
        </ListView>
    </Grid>
</Page>
