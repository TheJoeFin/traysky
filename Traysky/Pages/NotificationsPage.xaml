<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Traysky.Pages.NotificationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:Traysky.Helpers"
    xmlns:items="using:Traysky.ViewModels.Items"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <Grid>
        <ListView
            x:Name="NotificationList"
            IsItemClickEnabled="True"
            ItemClick="NotificationList_ItemClick"
            ItemsSource="{x:Bind ViewModel.Items}"
            SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="items:NotificationItem">
                    <Grid
                        Padding="12,10"
                        Background="{x:Bind helpers:BindHelpers.UnreadBackground(IsUnread)}"
                        ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid
                            Width="{StaticResource AvatarSize}"
                            Height="{StaticResource AvatarSize}"
                            VerticalAlignment="Top">
                            <PersonPicture
                                Width="{StaticResource AvatarSize}"
                                Height="{StaticResource AvatarSize}"
                                DisplayName="{x:Bind AuthorDisplayName}"
                                ProfilePicture="{x:Bind helpers:BindHelpers.ImageFromUri(AvatarUri)}" />
                            <Border
                                Width="18"
                                Height="18"
                                Margin="0,0,-4,-4"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="9">
                                <FontIcon
                                    FontSize="10"
                                    Foreground="{x:Bind helpers:BindHelpers.BrushFromKey(GlyphBrushKey)}"
                                    Glyph="{x:Bind Glyph}" />
                            </Border>
                        </Grid>

                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock
                                FontSize="13"
                                Text="{x:Bind Headline}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                MaxLines="4"
                                Style="{StaticResource SecondaryTextStyle}"
                                Text="{x:Bind BodyText}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind HasBody}" />
                            <StackPanel
                                Margin="-6,2,0,0"
                                Orientation="Horizontal"
                                Visibility="{x:Bind HasPost}">
                                <Button
                                    Click="Reply_Click"
                                    Style="{StaticResource PostActionButtonStyle}"
                                    Tag="{x:Bind}"
                                    ToolTipService.ToolTip="Reply">
                                    <FontIcon FontSize="13" Glyph="&#xE97A;" />
                                </Button>
                                <Button
                                    Click="Like_Click"
                                    Style="{StaticResource PostActionButtonStyle}"
                                    Tag="{x:Bind}"
                                    ToolTipService.ToolTip="Like">
                                    <FontIcon
                                        FontSize="13"
                                        Foreground="{x:Bind helpers:BindHelpers.LikeBrush(Post.IsLiked), Mode=OneWay}"
                                        Glyph="{x:Bind Post.LikeGlyph, Mode=OneWay}" />
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Top"
                            Style="{StaticResource SecondaryTextStyle}"
                            Text="{x:Bind TimeAgo}"
                            ToolTipService.ToolTip="{x:Bind AbsoluteTime}" />

                        <Rectangle
                            Grid.ColumnSpan="3"
                            Height="1"
                            Margin="-12,0,-12,-10"
                            VerticalAlignment="Bottom"
                            Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.Footer>
                <Grid Height="40">
                    <ProgressRing
                        Width="20"
                        Height="20"
                        IsActive="{x:Bind ViewModel.IsLoadingMore, Mode=OneWay}" />
                </Grid>
            </ListView.Footer>
        </ListView>

        <ProgressRing
            Width="32"
            Height="32"
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

        <StackPanel
            MaxWidth="240"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
            <FontIcon
                FontSize="28"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="&#xEA8F;" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource SecondaryTextStyle}"
                Text="Nothing yet. Likes, replies and new followers show up here."
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>

        <InfoBar
            Margin="12"
            VerticalAlignment="Top"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.Error, Mode=OneWay}"
            Severity="Warning">
            <InfoBar.ActionButton>
                <Button Command="{x:Bind ViewModel.RefreshCommand}" Content="Retry" />
            </InfoBar.ActionButton>
        </InfoBar>
    </Grid>
</Page>
