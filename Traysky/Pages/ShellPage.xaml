<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Traysky.Pages.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:items="using:Traysky.ViewModels.Items"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <Page.Resources>
        <!--  Left-rail nav button: icon always, label only at the VeryWide breakpoint.  -->
        <Style x:Key="RailButtonStyle" BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="MinWidth" Value="48" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="CornerRadius" Value="24" />
        </Style>

        <!--  Title bar button that sits with the caption buttons in the standard window: full bar height, square, caption-button width.  -->
        <Style x:Key="CaptionLikeButtonStyle" BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="46" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
    </Page.Resources>

    <!--
        Columns: left spacer | rail | page column | sidebar | right spacer. The spacers are almost-zero stars so the page
        column takes the width until it hits its MaxWidth (set in code), after which the spare width splits between the
        spacers and the whole arrangement stays centred, as on bsky.app.
    -->
    <Grid SizeChanged="Page_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.001*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition x:Name="ContentColumn" Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="0.001*" />
        </Grid.ColumnDefinitions>

        <TitleBar
            x:Name="SimpleTitleBar"
            Title="Traysky"
            Grid.ColumnSpan="5"
            BackRequested="TitleBar_BackRequested"
            DoubleTapped="TitleBar_DoubleTapped"
            IsBackButtonVisible="{x:Bind ViewModel.CanGoBack, Mode=OneWay}">
            <TitleBar.RightHeader>
                <StackPanel VerticalAlignment="Stretch" Orientation="Horizontal" Spacing="2">
                    <!--  The rail takes these over once the flyout is wide enough.  -->
                    <StackPanel Orientation="Horizontal" Spacing="2" Visibility="{x:Bind ViewModel.ShowHeaderNav, Mode=OneWay}">
                    <Button
                        x:Name="HomeButton"
                        AutomationProperties.AutomationId="HomeButton"
                        AutomationProperties.Name="Home"
                        Click="HomeButton_Click"
                        Style="{StaticResource TitleBarButtonStyle}"
                        ToolTipService.ToolTip="Home"
                        Visibility="{x:Bind ViewModel.ShowHome, Mode=OneWay}">
                        <FontIcon FontSize="14" Glyph="&#xE80F;" />
                    </Button>
                    <Button
                        x:Name="NewPostButton"
                        AutomationProperties.AutomationId="NewPostButton"
                        AutomationProperties.Name="New post"
                        Click="NewPostButton_Click"
                        Style="{StaticResource TitleBarButtonStyle}"
                        ToolTipService.ToolTip="New post (Ctrl+N)"
                        Visibility="{x:Bind ViewModel.IsSignedIn, Mode=OneWay}">
                        <FontIcon FontSize="14" Glyph="&#xE932;" />
                    </Button>
                    <Button
                        x:Name="ExploreButton"
                        AutomationProperties.AutomationId="ExploreButton"
                        AutomationProperties.Name="Explore"
                        Click="ExploreButton_Click"
                        Style="{StaticResource TitleBarButtonStyle}"
                        ToolTipService.ToolTip="Explore"
                        Visibility="{x:Bind ViewModel.IsSignedIn, Mode=OneWay}">
                        <FontIcon FontSize="14" Glyph="&#xE721;" />
                    </Button>
                    <Grid Visibility="{x:Bind ViewModel.IsSignedIn, Mode=OneWay}">
                        <Button
                            x:Name="NotificationsButton"
                            AutomationProperties.AutomationId="NotificationsButton"
                            AutomationProperties.Name="Notifications"
                            Click="NotificationsButton_Click"
                            Style="{StaticResource TitleBarButtonStyle}"
                            ToolTipService.ToolTip="Notifications (Ctrl+2)">
                            <FontIcon FontSize="14" Glyph="&#xEA8F;" />
                        </Button>
                        <InfoBadge
                            MinWidth="14"
                            MinHeight="14"
                            Margin="0,-2,-2,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            IsHitTestVisible="False"
                            Style="{StaticResource AttentionValueInfoBadgeStyle}"
                            Visibility="{x:Bind ViewModel.HasUnread, Mode=OneWay}"
                            Value="{x:Bind ViewModel.UnreadCount, Mode=OneWay}" />
                    </Grid>
                    <!--  Direct messages: only once ChatService has confirmed this session was granted DM access.  -->
                    <Grid Visibility="{x:Bind ViewModel.ShowMessages, Mode=OneWay}">
                        <Button
                            x:Name="MessagesButton"
                            AutomationProperties.AutomationId="MessagesButton"
                            AutomationProperties.Name="Messages"
                            Click="MessagesButton_Click"
                            Style="{StaticResource TitleBarButtonStyle}"
                            ToolTipService.ToolTip="Messages (Ctrl+3)">
                            <FontIcon FontSize="14" Glyph="&#xE8BD;" />
                        </Button>
                        <InfoBadge
                            MinWidth="14"
                            MinHeight="14"
                            Margin="0,-2,-2,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            IsHitTestVisible="False"
                            Style="{StaticResource AttentionValueInfoBadgeStyle}"
                            Visibility="{x:Bind ViewModel.HasUnreadMessages, Mode=OneWay}"
                            Value="{x:Bind ViewModel.UnreadMessageCount, Mode=OneWay}" />
                    </Grid>
                    <!--  Your profile while signed in (Settings is a button on it), straight to Settings while signed out.  -->
                    <Button
                        x:Name="AccountButton"
                        AutomationProperties.AutomationId="AccountButton"
                        AutomationProperties.Name="Profile and settings"
                        Click="AccountButton_Click"
                        Style="{StaticResource TitleBarButtonStyle}"
                        ToolTipService.ToolTip="Profile and settings">
                        <FontIcon FontSize="14" Glyph="&#xEF58;" />
                    </Button>
                    </StackPanel>
                    <!--  Standard window only: shrink back to the tray flyout. Sits beside Quit like another caption button.  -->
                    <Button
                        x:Name="ReturnToFlyoutButton"
                        AutomationProperties.AutomationId="ReturnToFlyoutButton"
                        AutomationProperties.Name="Return to flyout"
                        Click="ReturnToFlyoutButton_Click"
                        Style="{StaticResource CaptionLikeButtonStyle}"
                        ToolTipService.ToolTip="Return to flyout"
                        Visibility="Collapsed">
                        <FontIcon FontSize="12" Glyph="&#xE73F;" />
                    </Button>
                    <Button
                        x:Name="QuitButton"
                        AutomationProperties.AutomationId="QuitButton"
                        AutomationProperties.Name="Quit Traysky"
                        Click="QuitButton_Click"
                        Style="{StaticResource TitleBarButtonStyle}"
                        ToolTipService.ToolTip="Quit Traysky">
                        <FontIcon FontSize="14" Glyph="&#xE7E8;" />
                    </Button>
                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>

        <!--  Left rail (Medium and wider): the nav buttons the title bar carries in the compact flyout.  -->
        <StackPanel
            x:Name="Rail"
            Grid.Row="1"
            Grid.Column="1"
            Margin="8,8,8,8"
            Spacing="4"
            Visibility="{x:Bind ViewModel.ShowRail, Mode=OneWay}">
            <Button
                x:Name="RailHomeButton"
                AutomationProperties.AutomationId="RailHomeButton"
                AutomationProperties.Name="Home"
                Click="HomeButton_Click"
                Style="{StaticResource RailButtonStyle}"
                ToolTipService.ToolTip="Home (Ctrl+1)">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <FontIcon FontSize="22" Glyph="&#xE80F;" />
                    <TextBlock VerticalAlignment="Center" FontSize="18" Text="Home" Visibility="{x:Bind ViewModel.ShowRailLabels, Mode=OneWay}" />
                </StackPanel>
            </Button>
            <Button
                x:Name="RailExploreButton"
                AutomationProperties.AutomationId="RailExploreButton"
                AutomationProperties.Name="Explore"
                Click="ExploreButton_Click"
                Style="{StaticResource RailButtonStyle}"
                ToolTipService.ToolTip="Explore">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <FontIcon FontSize="22" Glyph="&#xE721;" />
                    <TextBlock VerticalAlignment="Center" FontSize="18" Text="Explore" Visibility="{x:Bind ViewModel.ShowRailLabels, Mode=OneWay}" />
                </StackPanel>
            </Button>
            <Grid>
                <Button
                    x:Name="RailNotificationsButton"
                    AutomationProperties.AutomationId="RailNotificationsButton"
                    AutomationProperties.Name="Notifications"
                    Click="NotificationsButton_Click"
                    Style="{StaticResource RailButtonStyle}"
                    ToolTipService.ToolTip="Notifications (Ctrl+2)">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <FontIcon FontSize="22" Glyph="&#xEA8F;" />
                        <TextBlock VerticalAlignment="Center" FontSize="18" Text="Notifications" Visibility="{x:Bind ViewModel.ShowRailLabels, Mode=OneWay}" />
                    </StackPanel>
                </Button>
                <InfoBadge
                    MinWidth="14"
                    MinHeight="14"
                    Margin="0,2,2,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    IsHitTestVisible="False"
                    Style="{StaticResource AttentionValueInfoBadgeStyle}"
                    Visibility="{x:Bind ViewModel.HasUnread, Mode=OneWay}"
                    Value="{x:Bind ViewModel.UnreadCount, Mode=OneWay}" />
            </Grid>
            <Grid Visibility="{x:Bind ViewModel.ShowMessages, Mode=OneWay}">
                <Button
                    x:Name="RailMessagesButton"
                    AutomationProperties.AutomationId="RailMessagesButton"
                    AutomationProperties.Name="Messages"
                    Click="MessagesButton_Click"
                    Style="{StaticResource RailButtonStyle}"
                    ToolTipService.ToolTip="Messages (Ctrl+3)">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <FontIcon FontSize="22" Glyph="&#xE8BD;" />
                        <TextBlock VerticalAlignment="Center" FontSize="18" Text="Chat" Visibility="{x:Bind ViewModel.ShowRailLabels, Mode=OneWay}" />
                    </StackPanel>
                </Button>
                <InfoBadge
                    MinWidth="14"
                    MinHeight="14"
                    Margin="0,2,2,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    IsHitTestVisible="False"
                    Style="{StaticResource AttentionValueInfoBadgeStyle}"
                    Visibility="{x:Bind ViewModel.HasUnreadMessages, Mode=OneWay}"
                    Value="{x:Bind ViewModel.UnreadMessageCount, Mode=OneWay}" />
            </Grid>
            <Button
                x:Name="RailProfileButton"
                AutomationProperties.AutomationId="RailProfileButton"
                AutomationProperties.Name="Profile"
                Click="AccountButton_Click"
                Style="{StaticResource RailButtonStyle}"
                ToolTipService.ToolTip="Profile">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <FontIcon FontSize="22" Glyph="&#xEF58;" />
                    <TextBlock VerticalAlignment="Center" FontSize="18" Text="Profile" Visibility="{x:Bind ViewModel.ShowRailLabels, Mode=OneWay}" />
                </StackPanel>
            </Button>
            <Button
                x:Name="RailSettingsButton"
                AutomationProperties.AutomationId="RailSettingsButton"
                AutomationProperties.Name="Settings"
                Click="SettingsButton_Click"
                Style="{StaticResource RailButtonStyle}"
                ToolTipService.ToolTip="Settings">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <FontIcon FontSize="22" Glyph="&#xE713;" />
                    <TextBlock VerticalAlignment="Center" FontSize="18" Text="Settings" Visibility="{x:Bind ViewModel.ShowRailLabels, Mode=OneWay}" />
                </StackPanel>
            </Button>
            <Button
                x:Name="RailNewPostButton"
                Margin="0,12,0,0"
                AutomationProperties.AutomationId="RailNewPostButton"
                AutomationProperties.Name="New post"
                Click="NewPostButton_Click"
                CornerRadius="24"
                MinHeight="48"
                MinWidth="48"
                Padding="13,0"
                Style="{StaticResource AccentButtonStyle}"
                ToolTipService.ToolTip="New post (Ctrl+N)">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon FontSize="20" Glyph="&#xE932;" />
                    <TextBlock VerticalAlignment="Center" FontSize="16" Text="New post" Visibility="{x:Bind ViewModel.ShowRailLabels, Mode=OneWay}" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!--  The page column: feed tabs over the frame. Capped at ContentMaxWidth once the flyout is wide, and then centred.  -->
        <Grid
            x:Name="ContentHost"
            Grid.Row="1"
            Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

        <!--
            Feed tabs: the account's own pinned feeds (order and visibility mirror bsky.app), only while signed in and on the
            timeline. A plain ListView rather than CommunityToolkit's Segmented: Segmented's sliding-selection-indicator
            logic assumes a small fixed item count and crashed the native XAML engine outright when handed an
            ItemsStackPanel override for many items; ListView's horizontal-list override is the standard, Microsoft-tested
            pattern for exactly this (a horizontally scrolling row of any number of variously-sized items).
        -->
        <ListView
            x:Name="Tabs"
            AutomationProperties.AutomationId="FeedTabs"
            AutomationProperties.Name="Feeds"
            Grid.Row="0"
            Margin="12,4,12,6"
            HorizontalAlignment="Stretch"
            IsItemClickEnabled="True"
            ItemClick="Tabs_ItemClick"
            ItemsSource="{x:Bind ViewModel.Feeds, Mode=OneWay}"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.HorizontalScrollMode="Enabled"
            ScrollViewer.VerticalScrollBarVisibility="Disabled"
            ScrollViewer.VerticalScrollMode="Disabled"
            SelectionChanged="Tabs_SelectionChanged"
            SelectionMode="Single"
            Visibility="{x:Bind ViewModel.ShowTabs, Mode=OneWay}">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemContainerStyle>
                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                    <Setter Property="Margin" Value="0,0,4,8" />
                    <Setter Property="Padding" Value="14,6" />
                    <Setter Property="CornerRadius" Value="16" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="items:FeedTabItem">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="13" Glyph="{x:Bind IconGlyph}" />
                        <TextBlock Text="{x:Bind DisplayName}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Frame
            x:Name="ContentFrame"
            Grid.Row="1"
            Margin="0" />
        </Grid>

        <!--  Right column (Wide and up): search, and the pinned feeds as a list.  -->
        <Grid
            x:Name="Sidebar"
            Grid.Row="1"
            Grid.Column="3"
            Width="300"
            Margin="16,8,0,0"
            RowSpacing="8"
            Visibility="{x:Bind ViewModel.ShowSidebar, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <AutoSuggestBox
                x:Name="SidebarSearchBox"
                AutomationProperties.AutomationId="SidebarSearchBox"
                PlaceholderText="Search"
                QueryIcon="Find"
                QuerySubmitted="SidebarSearchBox_QuerySubmitted" />
            <ListView
                x:Name="SidebarFeeds"
                Grid.Row="1"
                AutomationProperties.AutomationId="SidebarFeeds"
                AutomationProperties.Name="Feeds"
                IsItemClickEnabled="True"
                ItemClick="SidebarFeeds_ItemClick"
                ItemsSource="{x:Bind ViewModel.Feeds, Mode=OneWay}"
                SelectionMode="Single">
                <ListView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                        <Setter Property="CornerRadius" Value="8" />
                        <Setter Property="Padding" Value="12,8" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="items:FeedTabItem">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon FontSize="16" Glyph="{x:Bind IconGlyph}" />
                            <TextBlock Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!--  Full-size image viewer: covers the whole shell, dismissed by tap or Escape.  -->
        <Grid
            x:Name="ImageOverlay"
            Grid.RowSpan="2"
            Grid.ColumnSpan="5"
            Background="#E6000000"
            Tapped="ImageOverlay_Tapped"
            Visibility="Collapsed">

            <!--
                Pinch / Ctrl+wheel to zoom, drag to pan once zoomed; OverlayImage is sized to
                the viewport in code-behind so it starts fit-to-window at zoom 1.
            -->
            <ScrollViewer
                x:Name="OverlayScrollViewer"
                Margin="16,44,16,16"
                HorizontalScrollBarVisibility="Hidden"
                HorizontalScrollMode="Auto"
                MaxZoomFactor="4"
                MinZoomFactor="1"
                SizeChanged="OverlayScrollViewer_SizeChanged"
                VerticalScrollBarVisibility="Hidden"
                VerticalScrollMode="Auto"
                ZoomMode="Enabled">
                <Image
                    x:Name="OverlayImage"
                    DoubleTapped="OverlayImage_DoubleTapped"
                    Stretch="Uniform" />
            </ScrollViewer>
            <Button
                Width="32"
                Height="32"
                Margin="8"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="#33FFFFFF"
                BorderThickness="0"
                AutomationProperties.AutomationId="ImageOverlayCloseButton"
                AutomationProperties.Name="Close"
                Click="ImageOverlayClose_Click"
                CornerRadius="16"
                ToolTipService.ToolTip="Close">
                <FontIcon
                    FontSize="13"
                    Foreground="White"
                    Glyph="&#xE711;" />
            </Button>
        </Grid>

        <!--  Video viewer: covers the whole shell, dismissed by tapping outside the player or Escape.  -->
        <Grid
            x:Name="VideoOverlay"
            Grid.RowSpan="2"
            Grid.ColumnSpan="5"
            x:Load="False"
            Background="#E6000000"
            Tapped="VideoOverlay_Tapped">
            <MediaPlayerElement
                x:Name="VideoPlayer"
                Margin="16,44,16,16"
                AreTransportControlsEnabled="True"
                AutoPlay="True"
                Stretch="Uniform"
                Tapped="VideoPlayer_Tapped" />
            <StackPanel
                Margin="8"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Orientation="Horizontal"
                Spacing="6">
                <Button
                    Width="32"
                    Height="32"
                    Background="#33FFFFFF"
                    BorderThickness="0"
                    AutomationProperties.AutomationId="VideoOverlayPopOutButton"
                    AutomationProperties.Name="Pop out"
                    Click="VideoOverlayPopOut_Click"
                    CornerRadius="16"
                    ToolTipService.ToolTip="Pop out">
                    <FontIcon
                        FontSize="13"
                        Foreground="White"
                        Glyph="&#xE8A7;" />
                </Button>
                <Button
                    Width="32"
                    Height="32"
                    Background="#33FFFFFF"
                    BorderThickness="0"
                    AutomationProperties.AutomationId="VideoOverlayCloseButton"
                    AutomationProperties.Name="Close"
                    Click="VideoOverlayClose_Click"
                    CornerRadius="16"
                    ToolTipService.ToolTip="Close">
                    <FontIcon
                        FontSize="13"
                        Foreground="White"
                        Glyph="&#xE711;" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
