<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Traysky.Pages.ConversationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Traysky.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:Traysky.Helpers"
    xmlns:items="using:Traysky.ViewModels.Items"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Who this conversation is with; tapping opens their profile (1:1 only).  -->
        <Grid
            x:Name="Header"
            Padding="12,2,12,8"
            Background="Transparent"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            ColumnSpacing="10"
            Tapped="Header_Tapped">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <PersonPicture
                Width="32"
                Height="32"
                DisplayName="{x:Bind ViewModel.Conversation.Title, Mode=OneWay}"
                ProfilePicture="{x:Bind helpers:BindHelpers.ImageFromUri(ViewModel.Conversation.AvatarUri), Mode=OneWay}" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock
                    FontWeight="SemiBold"
                    Text="{x:Bind ViewModel.Conversation.Title, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Style="{StaticResource SecondaryTextStyle}"
                    Text="{x:Bind ViewModel.Conversation.Subtitle, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <InfoBar
            Grid.Row="1"
            Margin="12,8,12,0"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.Conversation.IsRequest, Mode=OneWay}"
            Message="This is a message request. Reply or accept it to move it to your inbox."
            Severity="Informational">
            <InfoBar.ActionButton>
                <Button Command="{x:Bind ViewModel.AcceptCommand}" Content="Accept" />
            </InfoBar.ActionButton>
        </InfoBar>

        <ListView
            x:Name="MessageList"
            Grid.Row="2"
            Padding="0,0,0,8"
            IsItemClickEnabled="False"
            ItemsSource="{x:Bind ViewModel.Messages}"
            SelectionMode="None">
            <ListView.Resources>
                <!--  Chat bubbles aren't clickable rows; no hover or press wash behind them.  -->
                <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
            </ListView.Resources>
            <ListView.ItemContainerStyle>
                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                    <Setter Property="Padding" Value="12,0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.Header>
                <Grid Height="36">
                    <ProgressRing
                        Width="20"
                        Height="20"
                        IsActive="{x:Bind ViewModel.IsLoadingOlder, Mode=OneWay}" />
                </Grid>
            </ListView.Header>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="items:MessageItem">
                    <StackPanel
                        MaxWidth="300"
                        Margin="{x:Bind RunMargin, Mode=OneWay}"
                        HorizontalAlignment="{x:Bind Alignment}"
                        Spacing="2">
                        <StackPanel
                            Margin="4,0,4,2"
                            HorizontalAlignment="{x:Bind Alignment}"
                            Orientation="Horizontal"
                            Spacing="6"
                            Visibility="{x:Bind RunHeaderVisibility, Mode=OneWay}">
                            <TextBlock
                                FontSize="11"
                                FontWeight="SemiBold"
                                Text="{x:Bind SenderName}"
                                Visibility="{x:Bind SenderNameVisibility, Mode=OneWay}" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind RunTimeText}" />
                        </StackPanel>

                        <!--  Received messages end in a "..." button (dim until the pointer is over the message) that opens reactions and copy.  -->
                        <Grid
                            HorizontalAlignment="{x:Bind Alignment}"
                            Background="Transparent"
                            PointerEntered="Message_PointerEntered"
                            PointerExited="Message_PointerExited">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button
                                x:Name="ReactButton"
                                Grid.Column="1"
                                Padding="6"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                Opacity="0.45"
                                ToolTipService.ToolTip="Options"
                                Visibility="{x:Bind OptionsButtonVisibility}">
                                <FontIcon FontSize="14" Glyph="&#xE712;" />
                                <Button.Flyout>
                                    <Flyout Placement="Top">
                                        <StackPanel Spacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="2">
                                                <Button Click="Emoji_Click" Content="👍" Tag="{x:Bind}" />
                                                <Button Click="Emoji_Click" Content="❤️" Tag="{x:Bind}" />
                                                <Button Click="Emoji_Click" Content="😂" Tag="{x:Bind}" />
                                                <Button Click="Emoji_Click" Content="😮" Tag="{x:Bind}" />
                                                <Button Click="Emoji_Click" Content="😢" Tag="{x:Bind}" />
                                                <Button Click="Emoji_Click" Content="🙏" Tag="{x:Bind}" />
                                            </StackPanel>
                                            <Button
                                                HorizontalAlignment="Stretch"
                                                Click="CopyText_Click"
                                                Content="Copy text"
                                                Tag="{x:Bind}"
                                                Visibility="{x:Bind HasText}" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>

                        <Border
                            Grid.Column="0"
                            MaxWidth="268"
                            Padding="12,7"
                            HorizontalAlignment="{x:Bind Alignment}"
                            Background="{x:Bind helpers:BindHelpers.BrushFromKey(BubbleBrushKey)}"
                            CornerRadius="14"
                            ToolTipService.ToolTip="{x:Bind TimeText}">
                            <StackPanel Spacing="6">
                                <RichTextBlock
                                    MaxWidth="244"
                                    helpers:ChatMessageText.Message="{x:Bind}"
                                    Foreground="{x:Bind helpers:BindHelpers.BrushFromKey(TextBrushKey)}"
                                    IsTextSelectionEnabled="True"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind HasText}" />
                                <TextBlock
                                    FontStyle="Italic"
                                    Foreground="{x:Bind helpers:BindHelpers.BrushFromKey(TextBrushKey)}"
                                    Opacity="0.7"
                                    Text="Message deleted"
                                    Visibility="{x:Bind IsDeleted}" />
                                <controls:EmbedPresenter
                                    MinWidth="220"
                                    Embed="{x:Bind Embed}"
                                    Visibility="{x:Bind HasEmbed}" />
                            </StackPanel>
                        </Border>
                        </Grid>

                        <TextBlock
                            Margin="6,0"
                            HorizontalAlignment="{x:Bind Alignment}"
                            FontSize="12"
                            Text="{x:Bind ReactionsText, Mode=OneWay}"
                            Visibility="{x:Bind HasReactions, Mode=OneWay}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ProgressRing
            Grid.Row="2"
            Width="32"
            Height="32"
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

        <TextBlock
            Grid.Row="2"
            MaxWidth="240"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Style="{StaticResource SecondaryTextStyle}"
            Text="No messages yet. Say hello."
            TextAlignment="Center"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />

        <InfoBar
            Grid.Row="3"
            Margin="12,0,12,6"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.Error, Mode=OneWay}"
            Severity="Warning" />

        <!--  Enter sends, Shift+Enter starts a new line.  -->
        <Grid
            Grid.Row="4"
            Padding="12,8,12,12"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="DraftBox"
                MaxHeight="120"
                AcceptsReturn="True"
                MaxLength="1000"
                PlaceholderText="Write a message"
                PreviewKeyDown="DraftBox_PreviewKeyDown"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                Text="{x:Bind ViewModel.Draft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap" />
            <Button
                Grid.Column="1"
                VerticalAlignment="Bottom"
                Command="{x:Bind ViewModel.SendCommand}"
                Style="{StaticResource AccentButtonStyle}"
                ToolTipService.ToolTip="Send (Enter)">
                <FontIcon FontSize="14" Glyph="&#xE724;" />
            </Button>
        </Grid>
    </Grid>
</Page>
