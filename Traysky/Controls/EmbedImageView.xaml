<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Traysky.Controls.EmbedImageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation
                Storyboard.TargetName="Picture"
                Storyboard.TargetProperty="Opacity"
                To="1"
                Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="Placeholder"
                Storyboard.TargetProperty="Opacity"
                To="0"
                Duration="0:0:0.2" />
        </Storyboard>
    </UserControl.Resources>

    <Grid Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="{StaticResource EmbedCornerRadius}">
        <FontIcon
            x:Name="Placeholder"
            FontSize="20"
            Foreground="{ThemeResource TextFillColorDisabledBrush}"
            Glyph="&#xE91B;" />
        <Image
            x:Name="Picture"
            ImageFailed="Picture_ImageFailed"
            ImageOpened="Picture_ImageOpened"
            Opacity="0"
            Stretch="Uniform">
            <Image.Source>
                <BitmapImage x:Name="Bitmap" DecodePixelWidth="640" />
            </Image.Source>
        </Image>
        <Border
            x:Name="PlayGlyph"
            Width="40"
            Height="40"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#A0000000"
            CornerRadius="20"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <FontIcon
                FontSize="16"
                Foreground="White"
                Glyph="&#xE768;" />
        </Border>
        <Button
            x:Name="PopOutButton"
            Width="28"
            Height="28"
            Margin="6"
            Padding="0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Background="#A0000000"
            BorderThickness="0"
            Click="PopOutButton_Click"
            CornerRadius="14"
            Tapped="PopOutButton_Tapped"
            ToolTipService.ToolTip="Pop out"
            Visibility="Collapsed">
            <FontIcon
                FontSize="12"
                Foreground="White"
                Glyph="&#xE8A7;" />
        </Button>
    </Grid>
</UserControl>
