<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Traysky.Controls.ComposeBox"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animations="using:CommunityToolkit.WinUI.Animations"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:Traysky.Helpers"
    xmlns:vm="using:Traysky.ViewModels"
    xmlns:items="using:Traysky.ViewModels.Items"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Key="MentionSuggestionTemplate" x:DataType="items:MentionSuggestionItem">
            <StackPanel Orientation="Horizontal" Padding="8,6" Spacing="8">
                <PersonPicture
                    Width="28"
                    Height="28"
                    DisplayName="{x:Bind NameOrHandle}"
                    ProfilePicture="{x:Bind helpers:BindHelpers.ImageFromUri(AvatarUri)}" />
                <StackPanel VerticalAlignment="Center" Spacing="0">
                    <TextBlock FontWeight="SemiBold" Text="{x:Bind NameOrHandle}" />
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind HandleDisplay}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="HashtagSuggestionTemplate" x:DataType="items:HashtagSuggestionItem">
            <StackPanel Orientation="Horizontal" Padding="8,6" Spacing="8">
                <FontIcon FontSize="14" Glyph="&#xE8EC;" />
                <TextBlock VerticalAlignment="Center" Text="{x:Bind Display}" />
            </StackPanel>
        </DataTemplate>

        <helpers:ComposeSuggestionTemplateSelector
            x:Key="ComposeSuggestionTemplateSelector"
            HashtagTemplate="{StaticResource HashtagSuggestionTemplate}"
            MentionTemplate="{StaticResource MentionSuggestionTemplate}" />

        <DataTemplate x:Key="AttachmentTemplate" x:DataType="items:ComposeAttachmentItem">
            <Border
                Width="88"
                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                CornerRadius="{StaticResource EmbedCornerRadius}">
                <StackPanel Spacing="4">
                    <Grid Height="66">
                        <Image
                            Stretch="UniformToFill"
                            Source="{x:Bind helpers:BindHelpers.AttachmentThumbnail(IsVideo, Bytes)}"
                            Visibility="{x:Bind helpers:BindHelpers.CollapsedIf(IsVideo)}" />
                        <FontIcon
                            FontSize="20"
                            Glyph="&#xE768;"
                            Visibility="{x:Bind helpers:BindHelpers.VisibleIf(IsVideo)}" />
                        <Button
                            Margin="4"
                            Padding="4,2"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Bottom"
                            AutomationProperties.AutomationId="CompressAttachmentButton"
                            Command="{x:Bind vm:ComposeViewModel.Instance.CompressAttachmentCommand}"
                            CommandParameter="{x:Bind}"
                            Content="Compress"
                            FontSize="11"
                            Style="{StaticResource AccentButtonStyle}"
                            ToolTipService.ToolTip="Too large for Bluesky (about 1 MB max). Shrinks the image, losing some quality."
                            Visibility="{x:Bind helpers:BindHelpers.VisibleIf(IsOversized)}" />
                        <Button
                            Width="22"
                            Height="22"
                            Margin="2"
                            Padding="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="#A0000000"
                            BorderThickness="0"
                            AutomationProperties.AutomationId="RemoveAttachmentButton"
                            AutomationProperties.Name="Remove attachment"
                            Command="{x:Bind vm:ComposeViewModel.Instance.RemoveAttachmentCommand}"
                            CommandParameter="{x:Bind}"
                            CornerRadius="11"
                            ToolTipService.ToolTip="Remove">
                            <FontIcon
                                FontSize="10"
                                Foreground="White"
                                Glyph="&#xE711;" />
                        </Button>
                    </Grid>
                    <TextBox
                        Margin="4,0,4,4"
                        AutomationProperties.AutomationId="AttachmentAltTextBox"
                        AutomationProperties.Name="Alt text"
                        FontSize="11"
                        PlaceholderText="Alt text"
                        Text="{x:Bind AltText, Mode=TwoWay}" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="DraftTemplate" x:DataType="items:DraftItem">
            <Grid ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="OpenDraftButton"
                    HorizontalContentAlignment="Left"
                    Click="OpenDraft_Click"
                    Tag="{x:Bind}">
                    <StackPanel Spacing="2">
                        <TextBlock
                            MaxLines="2"
                            Text="{x:Bind Preview}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Age}" />
                        <TextBlock
                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                            Style="{StaticResource SecondaryTextStyle}"
                            Text="{x:Bind Note}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind helpers:BindHelpers.VisibleIf(HasNote)}" />
                    </StackPanel>
                </Button>
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Top"
                    AutomationProperties.AutomationId="DeleteDraftButton"
                    AutomationProperties.Name="Delete draft"
                    Click="DeleteDraft_Click"
                    Tag="{x:Bind}"
                    Style="{StaticResource PostActionButtonStyle}"
                    ToolTipService.ToolTip="Delete draft">
                    <FontIcon FontSize="12" Glyph="&#xE74D;" />
                </Button>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Border
        x:Name="DropZone"
        Margin="12,6,12,4"
        Padding="10,8"
        AllowDrop="True"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="10">
        <StackPanel Spacing="6">

            <!--  Replying to / Quoting strip  -->
            <Grid
                animations:Implicit.HideAnimations="{StaticResource ImplicitFadeHideAnimations}"
                animations:Implicit.ShowAnimations="{StaticResource ImplicitFadeShowAnimations}"
                ColumnSpacing="6"
                Visibility="{x:Bind ViewModel.HasContext, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Style="{StaticResource SecondaryTextStyle}"
                    Text="{x:Bind ViewModel.ContextLabel, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <Button
                    Grid.Column="1"
                    Padding="4"
                    AutomationProperties.AutomationId="ClearContextButton"
                    AutomationProperties.Name="Cancel reply or quote"
                    Command="{x:Bind ViewModel.ClearContextCommand}"
                    Style="{StaticResource PostActionButtonStyle}"
                    ToolTipService.ToolTip="Cancel">
                    <FontIcon FontSize="11" Glyph="&#xE711;" />
                </Button>
            </Grid>

            <controls:RichSuggestBox
                x:Name="Editor"
                AutomationProperties.AutomationId="ComposeEditor"
                AutomationProperties.Name="Post text"
                BorderThickness="0"
                ClipboardCopyFormat="PlainText"
                ClipboardPasteFormat="PlainText"
                DisabledFormattingAccelerators="All"
                GotFocus="Editor_GotFocus"
                ItemTemplateSelector="{StaticResource ComposeSuggestionTemplateSelector}"
                LostFocus="Editor_LostFocus"
                MaxHeight="{x:Bind EditorMaxHeight(IsPageMode), Mode=OneWay}"
                MinHeight="{x:Bind EditorMinHeight(ViewModel.IsExpanded, IsPageMode), Mode=OneWay}"
                Paste="Editor_Paste"
                PlaceholderText="{x:Bind ViewModel.Placeholder, Mode=OneWay}"
                Prefixes="@"
                PreviewKeyDown="Editor_PreviewKeyDown"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                SuggestionChosen="Editor_SuggestionChosen"
                SuggestionRequested="Editor_SuggestionRequested"
                TextChanged="Editor_TextChanged" />

            <!--  '#' suggestions are ours, not the editor's: see HashtagFacetPolicy.TryFindOpenTag. Sits at the editor's bottom edge; none of its items take focus, so the editor keeps the caret.  -->
            <Popup x:Name="HashtagPopup" VerticalOffset="2">
                <Border
                    x:Name="HashtagPopupBorder"
                    MaxHeight="200"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <ListView
                        x:Name="HashtagList"
                        AllowFocusOnInteraction="False"
                        AutomationProperties.AutomationId="HashtagSuggestionList"
                        AutomationProperties.Name="Hashtag suggestions"
                        IsItemClickEnabled="True"
                        IsTabStop="False"
                        ItemClick="HashtagList_ItemClick"
                        ItemTemplate="{StaticResource HashtagSuggestionTemplate}"
                        SelectionMode="Single">
                        <ListView.ItemContainerStyle>
                            <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                                <Setter Property="AllowFocusOnInteraction" Value="False" />
                                <Setter Property="IsTabStop" Value="False" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </Border>
            </Popup>

            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.Error, Mode=OneWay}"
                Severity="Error" />

            <!--  Link preview, generated from the first link in the draft once typing pauses  -->
            <ProgressBar
                IsIndeterminate="True"
                Visibility="{x:Bind ViewModel.HasLinkCardPlaceholder, Mode=OneWay}" />
            <Border Style="{StaticResource EmbedCardStyle}" Visibility="{x:Bind ViewModel.HasLinkCard, Mode=OneWay}">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="72"
                        Height="72"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        CornerRadius="8,0,0,8"
                        Visibility="{x:Bind ViewModel.HasLinkCardThumbnail, Mode=OneWay}">
                        <Image Stretch="UniformToFill">
                            <Image.Source>
                                <BitmapImage DecodePixelWidth="160" UriSource="{x:Bind ViewModel.LinkCardThumbnail, Mode=OneWay}" />
                            </Image.Source>
                        </Image>
                    </Border>
                    <StackPanel
                        Grid.Column="1"
                        Margin="0,8,0,8"
                        VerticalAlignment="Center"
                        Spacing="4">
                        <TextBlock
                            Margin="0,0,0,2"
                            Style="{StaticResource SecondaryTextStyle}"
                            Text="{x:Bind ViewModel.LinkCardHost, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            FontWeight="SemiBold"
                            MaxLines="2"
                            Text="{x:Bind ViewModel.LinkCardTitle, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />
                        <TextBlock
                            MaxLines="2"
                            Style="{StaticResource SecondaryTextStyle}"
                            Text="{x:Bind ViewModel.LinkCardDescription, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.HasLinkCardDescription, Mode=OneWay}" />
                    </StackPanel>
                    <Button
                        Grid.Column="2"
                        Margin="0,4,4,0"
                        Padding="4"
                        VerticalAlignment="Top"
                        AutomationProperties.AutomationId="DismissLinkCardButton"
                        AutomationProperties.Name="Remove link preview"
                        Command="{x:Bind ViewModel.DismissLinkCardCommand}"
                        Style="{StaticResource PostActionButtonStyle}"
                        ToolTipService.ToolTip="Remove link preview">
                        <FontIcon FontSize="11" Glyph="&#xE711;" />
                    </Button>
                </Grid>
            </Border>

            <!--  Picked images / video, not yet uploaded  -->
            <ScrollViewer
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Auto"
                VerticalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled"
                Visibility="{x:Bind ViewModel.HasAttachments, Mode=OneWay}">
                <ItemsRepeater ItemTemplate="{StaticResource AttachmentTemplate}" ItemsSource="{x:Bind ViewModel.Attachments}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Horizontal" Spacing="6" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </ScrollViewer>

            <!--  Attach + counter + Post button; only while expanded  -->
            <Grid
                animations:Implicit.HideAnimations="{StaticResource ImplicitFadeHideAnimations}"
                animations:Implicit.ShowAnimations="{StaticResource ImplicitFadeShowAnimations}"
                ColumnSpacing="4"
                RowSpacing="{x:Bind ActionRowSpacing(IsPageMode), Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsExpanded, Mode=OneWay}">
                <!--  Popup: one row. Full-page compose: tools on the first row, status / counter / Post on the second  -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    Grid.Column="0"
                    AutomationProperties.AutomationId="AttachImageButton"
                    AutomationProperties.Name="Add image"
                    Command="{x:Bind ViewModel.AttachImageCommand}"
                    IsEnabled="{x:Bind ViewModel.CanAttachImage, Mode=OneWay}"
                    Style="{StaticResource PostActionButtonStyle}"
                    ToolTipService.ToolTip="Add image">
                    <FontIcon FontSize="14" Glyph="&#xEB9F;" />
                </Button>
                <Button
                    Grid.Column="1"
                    AutomationProperties.AutomationId="AttachVideoButton"
                    AutomationProperties.Name="Add video"
                    Command="{x:Bind ViewModel.AttachVideoCommand}"
                    IsEnabled="{x:Bind ViewModel.CanAttachVideo, Mode=OneWay}"
                    Style="{StaticResource PostActionButtonStyle}"
                    ToolTipService.ToolTip="Add video">
                    <FontIcon FontSize="14" Glyph="&#xE714;" />
                </Button>
                <Button
                    Grid.Column="2"
                    AutomationProperties.AutomationId="InteractionSettingsButton"
                    AutomationProperties.Name="Reply and quote settings"
                    Click="Interaction_Click"
                    Foreground="{x:Bind InteractionBrush(ViewModel.HasCustomInteraction), Mode=OneWay}"
                    Style="{StaticResource PostActionButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.InteractionSummary, Mode=OneWay}">
                    <FontIcon FontSize="14" Glyph="&#xE72E;" />
                </Button>
                <Button
                    Grid.Column="3"
                    AutomationProperties.AutomationId="DraftsButton"
                    AutomationProperties.Name="Drafts"
                    Style="{StaticResource PostActionButtonStyle}"
                    ToolTipService.ToolTip="Drafts">
                    <FontIcon FontSize="14" Glyph="&#xE70B;" />
                    <Button.Flyout>
                        <Flyout x:Name="DraftsFlyout" Opening="DraftsFlyout_Opening" Placement="TopEdgeAlignedLeft">
                            <StackPanel Width="300" Spacing="8">
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.AutomationId="SaveDraftButton"
                                        Command="{x:Bind ViewModel.SaveDraftCommand}"
                                        Content="Save draft" />
                                    <Button
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.AutomationId="SaveDraftAndClearButton"
                                        Command="{x:Bind ViewModel.SaveDraftAndClearCommand}"
                                        Content="Save and clear"
                                        ToolTipService.ToolTip="Saves the draft and empties the box" />
                                </Grid>
                                <TextBlock
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="{x:Bind ViewModel.DraftsStatus, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind ViewModel.HasDraftsStatus, Mode=OneWay}" />
                                <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsLoadingDrafts, Mode=OneWay}" />
                                <TextBlock
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="No saved drafts"
                                    Visibility="{x:Bind ViewModel.ShowNoDrafts, Mode=OneWay}" />
                                <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                                    <ItemsRepeater ItemTemplate="{StaticResource DraftTemplate}" ItemsSource="{x:Bind ViewModel.Drafts}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Orientation="Vertical" Spacing="4" />
                                        </ItemsRepeater.Layout>
                                    </ItemsRepeater>
                                </ScrollViewer>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button
                    x:Name="MentionsButton"
                    Grid.Column="4"
                    AutomationProperties.AutomationId="MentionsButton"
                    AutomationProperties.Name="Review mentioned profiles"
                    Style="{StaticResource PostActionButtonStyle}"
                    ToolTipService.ToolTip="Review mentioned profiles"
                    Visibility="Collapsed">
                    <FontIcon FontSize="14" Glyph="&#xE77B;" />
                    <Button.Flyout>
                        <Flyout x:Name="MentionsFlyout" Opening="MentionsFlyout_Opening" Placement="TopEdgeAlignedLeft">
                            <StackPanel x:Name="MentionsPanel" Width="240" Spacing="2" />
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <ToggleButton
                    x:Name="PinButton"
                    Grid.Column="5"
                    MinWidth="0"
                    MinHeight="28"
                    Padding="6,4"
                    AutomationProperties.AutomationId="PinWindowButton"
                    AutomationProperties.Name="Keep this window open"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="PinButton_Click"
                    ToolTipService.ToolTip="Keep this window open"
                    Visibility="{x:Bind helpers:BindHelpers.VisibleIf(IsPageMode), Mode=OneWay}">
                    <FontIcon FontSize="14" Glyph="&#xE718;" />
                </ToggleButton>
                <StackPanel
                    Grid.Row="{x:Bind ActionRow(IsPageMode), Mode=OneWay}"
                    Grid.Column="{x:Bind StatusColumn(IsPageMode), Mode=OneWay}"
                    Grid.ColumnSpan="{x:Bind StatusColumnSpan(IsPageMode), Mode=OneWay}"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource SecondaryTextStyle}"
                        Text="{x:Bind StatusText(ViewModel.UploadStatus, ViewModel.VideoLimitsText), Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <ProgressBar
                        Width="80"
                        VerticalAlignment="Center"
                        Maximum="1"
                        Value="{x:Bind ViewModel.UploadProgressValue, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasUploadProgress, Mode=OneWay}" />
                    <HyperlinkButton
                        Padding="4,0"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="CancelUploadButton"
                        Command="{x:Bind ViewModel.CancelUploadCommand}"
                        Content="Cancel"
                        Visibility="{x:Bind ViewModel.CanCancelUpload, Mode=OneWay}" />
                </StackPanel>
                <TextBlock
                    Grid.Row="{x:Bind ActionRow(IsPageMode), Mode=OneWay}"
                    Grid.Column="7"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{x:Bind CounterBrush(ViewModel.IsNearLimit, ViewModel.IsOverLimit), Mode=OneWay}"
                    Text="{x:Bind ViewModel.Counter, Mode=OneWay}" />
                <Button
                    Grid.Row="{x:Bind ActionRow(IsPageMode), Mode=OneWay}"
                    Grid.Column="8"
                    MinWidth="64"
                    AutomationProperties.AutomationId="PostButton"
                    Command="{x:Bind ViewModel.PostCommand}"
                    Style="{StaticResource AccentButtonStyle}">
                    <Grid>
                        <TextBlock Text="{x:Bind PostLabel(ViewModel.ReplyTo, ViewModel.QuoteOf), Mode=OneWay}" Visibility="{x:Bind CollapsedIf(ViewModel.IsPosting), Mode=OneWay}" />
                        <ProgressRing
                            Width="16"
                            Height="16"
                            IsActive="{x:Bind ViewModel.IsPosting, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsPosting, Mode=OneWay}" />
                    </Grid>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
