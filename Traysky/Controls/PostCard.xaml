<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Traysky.Controls.PostCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animations="using:CommunityToolkit.WinUI.Animations"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:Traysky.Helpers"
    xmlns:local="using:Traysky.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:Traysky.Services"
    mc:Ignorable="d">

    <Grid
        x:Name="Root"
        Padding="12,10,12,4"
        Background="Transparent"
        ColumnSpacing="10"
        Tapped="Root_Tapped">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  ♲ Reposted by …  -->
        <StackPanel
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Margin="0,0,0,2"
            Orientation="Horizontal"
            Spacing="6"
            Visibility="{x:Bind Post.HasRepostedBy, Mode=OneWay}">
            <FontIcon
                FontSize="11"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="&#xE8EE;" />
            <TextBlock Style="{StaticResource SecondaryTextStyle}" TextTrimming="CharacterEllipsis">
                <Run Text="Reposted by" />
                <Run FontWeight="SemiBold" Text="{x:Bind Post.RepostedBy, Mode=OneWay}" />
            </TextBlock>
        </StackPanel>

        <!--  Avatar column. In the timeline a reply is joined to the post it replies to by a line
              down from one avatar to the next: LineAbove runs up through the card's top padding,
              LineBelow down through its bottom padding, so the line is unbroken across cards.  -->
        <Grid
            Grid.Row="1"
            Grid.RowSpan="6"
            Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Rectangle
                Width="2"
                Height="10"
                Margin="0,-10,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Fill="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                Visibility="{x:Bind Post.ThreadLineAbove, Mode=OneWay}" />
            <PersonPicture
                x:Name="Avatar"
                Width="{StaticResource AvatarSize}"
                Height="{StaticResource AvatarSize}"
                VerticalAlignment="Top"
                DisplayName="{x:Bind Post.AuthorDisplayName, Mode=OneWay}"
                ProfilePicture="{x:Bind helpers:BindHelpers.ImageFromUri(Post.AvatarUri), Mode=OneWay}"
                AutomationProperties.AutomationId="PostAuthorAvatar"
                AutomationProperties.Name="View profile"
                Tapped="Avatar_Tapped"
                ToolTipService.ToolTip="View profile" />
            <Rectangle
                Grid.Row="1"
                Width="2"
                Margin="0,4,0,-4"
                HorizontalAlignment="Center"
                Fill="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                Visibility="{x:Bind Post.ThreadLineBelow, Mode=OneWay}" />
        </Grid>

        <!--  Name, handle, time  -->
        <Grid
            Grid.Row="1"
            Grid.Column="1"
            ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                MaxWidth="160"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Text="{x:Bind Post.AuthorDisplayName, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />

            <!--  Community labels on the author: click for the full list, without leaving the feed.
                  x:Load, since almost no author has any and a Button with a Flyout is not free.  -->
            <Button
                x:Name="LabelsButton"
                Grid.Column="1"
                Margin="-4,0,-2,0"
                Padding="4,2"
                VerticalAlignment="Center"
                x:Load="{x:Bind Post.HasAuthorLabels, Mode=OneWay, FallbackValue=False}"
                AutomationProperties.AutomationId="AuthorLabelsButton"
                AutomationProperties.Name="Labels on this account"
                Background="Transparent"
                BorderThickness="0"
                ToolTipService.ToolTip="{x:Bind Post.AuthorLabelsToolTip, Mode=OneWay}">
                <FontIcon
                    FontSize="12"
                    Foreground="{x:Bind LabelIconBrush(Post.HasAlertLabel), Mode=OneWay}"
                    Glyph="&#xE8EC;" />
                <Button.Flyout>
                    <Flyout Opening="LabelsFlyout_Opening" Placement="BottomEdgeAlignedLeft">
                        <StackPanel MaxWidth="300" Spacing="8">
                            <TextBlock FontWeight="SemiBold" Text="Labels on this account" />
                            <ItemsControl>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="services:LabelDisplay">
                                        <StackPanel Margin="0,0,0,8" Spacing="2">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{x:Bind Name}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Style="{StaticResource SecondaryTextStyle}"
                                                Text="{x:Bind Description}"
                                                TextWrapping="Wrap"
                                                Visibility="{x:Bind HasDescription}" />
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                Text="{x:Bind SourceLine}"
                                                TextWrapping="Wrap"
                                                Visibility="{x:Bind HasSourceLine}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <TextBlock
                Grid.Column="2"
                VerticalAlignment="Center"
                Style="{StaticResource SecondaryTextStyle}"
                Text="{x:Bind Post.HandleDisplay, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                Grid.Column="3"
                VerticalAlignment="Center"
                Style="{StaticResource SecondaryTextStyle}"
                Text="{x:Bind Post.TimeAgo, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind Post.AbsoluteTime, Mode=OneWay}" />
        </Grid>

        <TextBlock
            Grid.Row="2"
            Grid.Column="1"
            Margin="0,2,0,0"
            Style="{StaticResource SecondaryTextStyle}"
            Text="{x:Bind Post.ReplyingToDisplay, Mode=OneWay}"
            Visibility="{x:Bind Post.HasReplyingTo, Mode=OneWay}" />

        <RichTextBlock
            x:Name="PostText"
            Grid.Row="3"
            Grid.Column="1"
            Margin="0,4,0,0"
            Style="{StaticResource PostTextStyle}"
            Visibility="{x:Bind Post.HasText, Mode=OneWay}" />

        <!--  x:Load, not Visibility: most posts have no embed, and a collapsed presenter
              would still build its whole tree.  -->
        <local:EmbedPresenter
            x:Name="EmbedView"
            Grid.Row="4"
            Grid.Column="1"
            Margin="0,8,0,0"
            x:Load="{x:Bind Post.HasEmbed, Mode=OneWay, FallbackValue=False}"
            Embed="{x:Bind Post.Embed, Mode=OneWay}"
            FallbackUrl="{x:Bind Post.WebUrl, Mode=OneWay}"
            IsContained="{x:Bind IsContained, Mode=OneWay}" />

        <!--  Actions (none on a contained card)  -->
        <Grid
            Grid.Row="5"
            Grid.Column="1"
            Margin="-6,4,0,0"
            Visibility="{x:Bind helpers:BindHelpers.CollapsedIf(IsContained), Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button
                    AutomationProperties.AutomationId="ReplyButton"
                    AutomationProperties.Name="Reply"
                    Click="Reply_Click"
                    Style="{StaticResource PostActionButtonStyle}"
                    ToolTipService.ToolTip="Reply">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon FontSize="14" Glyph="&#xE97A;" />
                        <TextBlock Text="{x:Bind Post.ReplyCountDisplay, Mode=OneWay}" />
                    </StackPanel>
                </Button>
                <Button
                    AutomationProperties.AutomationId="RepostButton"
                    AutomationProperties.Name="Repost or quote"
                    Style="{StaticResource PostActionButtonStyle}"
                    ToolTipService.ToolTip="Repost or quote">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon
                            FontSize="14"
                            Foreground="{x:Bind RepostBrush(Post.IsReposted), Mode=OneWay}"
                            Glyph="&#xE8EE;" />
                        <TextBlock Foreground="{x:Bind RepostBrush(Post.IsReposted), Mode=OneWay}" Text="{x:Bind Post.RepostCountDisplay, Mode=OneWay}" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout Opening="RepostMenu_Opening" Placement="BottomEdgeAlignedLeft">
                            <MenuFlyoutItem x:Name="RepostItem" Click="Repost_Click" Text="Repost">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8EE;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Click="Quote_Click" Text="Quote post">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE9B2;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button
                    AutomationProperties.AutomationId="LikeButton"
                    AutomationProperties.Name="Like"
                    Click="Like_Click"
                    Style="{StaticResource PostActionButtonStyle}"
                    ToolTipService.ToolTip="Like">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon
                            FontSize="14"
                            Foreground="{x:Bind LikeBrush(Post.IsLiked), Mode=OneWay}"
                            Glyph="{x:Bind Post.LikeGlyph, Mode=OneWay}" />
                        <TextBlock Foreground="{x:Bind LikeBrush(Post.IsLiked), Mode=OneWay}" Text="{x:Bind Post.LikeCountDisplay, Mode=OneWay}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="2">
                <!--  Only on the post a thread page is about: who liked / reposted it.  -->
                <Button
                    AutomationProperties.AutomationId="EngagementButton"
                    AutomationProperties.Name="Likes, reposts and quotes"
                    Click="Engagement_Click"
                    Style="{StaticResource PostActionButtonStyle}"
                    ToolTipService.ToolTip="Likes, reposts and quotes"
                    Visibility="{x:Bind EngagementVisibility(IsOpenable), Mode=OneWay}">
                    <FontIcon FontSize="14" Glyph="&#xE946;" />
                </Button>
                <Button
                    AutomationProperties.AutomationId="BookmarkButton"
                    AutomationProperties.Name="{x:Bind Post.BookmarkLabel, Mode=OneWay}"
                    Click="Bookmark_Click"
                    Style="{StaticResource PostActionButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind Post.BookmarkLabel, Mode=OneWay}">
                    <!--  A Path, not a PathIcon: Stretch=Uniform drops the data's ~2px left offset, so the shape is centered and unclipped in its 10 x 14 slot.  -->
                    <Path
                        Width="10"
                        Height="14"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Data="F1 M3.116,15.862 C2.901,16.023 2.679,16.043 2.450,15.922 C2.222,15.801 2.107,15.619 2.107,15.377 L2.107,2.745 C2.107,1.991 2.376,1.345 2.915,0.807 C3.453,0.269 4.098,0.000 4.852,0.000 L11.148,0.000 C11.902,0.000 12.547,0.269 13.085,0.807 C13.624,1.345 13.893,1.991 13.893,2.745 L13.893,15.377 C13.893,15.619 13.778,15.801 13.550,15.922 C13.321,16.043 13.099,16.023 12.884,15.862 L8.000,12.350 Z M12.641,2.745 C12.641,2.341 12.493,1.998 12.197,1.715 C11.902,1.433 11.552,1.292 11.148,1.292 L4.852,1.292 C4.448,1.292 4.098,1.433 3.803,1.715 C3.507,1.998 3.359,2.341 3.359,2.745 L3.359,14.126 L7.637,11.059 C7.744,10.978 7.865,10.938 8.000,10.938 C8.135,10.938 8.256,10.978 8.363,11.059 L12.641,14.126 Z"
                        Fill="{x:Bind BookmarkBrush(Post.IsBookmarked), Mode=OneWay}"
                        Stretch="Uniform" />
                </Button>
                <Button
                    AutomationProperties.AutomationId="MoreButton"
                    AutomationProperties.Name="More"
                    Style="{StaticResource PostActionButtonStyle}"
                    ToolTipService.ToolTip="More">
                    <FontIcon FontSize="14" Glyph="&#xE712;" />
                    <Button.Flyout>
                        <MenuFlyout Opening="MoreMenu_Opening" Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Click="CopyLink_Click" Text="Copy link">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE71B;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Click="CopyText_Click" Text="Copy text">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8C8;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Click="OpenInBrowser_Click" Text="Open on bsky.app">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8A7;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Click="OpenProfile_Click" Text="View profile">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE77B;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator Visibility="{x:Bind Actions.ShowDeleteSeparator, Mode=OneWay}" />
                            <MenuFlyoutItem
                                Command="{x:Bind Actions.MuteThreadCommand}"
                                Text="{x:Bind Actions.MuteThreadLabel, Mode=OneWay}"
                                Visibility="{x:Bind Actions.ShowMuteThread, Mode=OneWay}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74F;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                Command="{x:Bind Actions.EditInteractionSettingsCommand}"
                                Text="Reply and quote settings…"
                                Visibility="{x:Bind Actions.ShowInteractionSettings, Mode=OneWay}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE72E;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                Command="{x:Bind Actions.DetachQuoteCommand}"
                                Text="Detach my post from this quote"
                                Visibility="{x:Bind Actions.ShowDetachQuote, Mode=OneWay}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE71B;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                Command="{x:Bind Actions.DeletePostCommand}"
                                Text="Delete post"
                                Visibility="{x:Bind Actions.ShowDelete, Mode=OneWay}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74D;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator Visibility="{x:Bind Actions.ShowModeration, Mode=OneWay}" />
                            <MenuFlyoutItem
                                Command="{x:Bind Actions.MuteAuthorCommand}"
                                Text="{x:Bind Actions.MuteAuthorLabel, Mode=OneWay}"
                                Visibility="{x:Bind Actions.ShowModeration, Mode=OneWay}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74F;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                Command="{x:Bind Actions.BlockAuthorCommand}"
                                Text="{x:Bind Actions.BlockAuthorLabel, Mode=OneWay}"
                                Visibility="{x:Bind Actions.ShowModeration, Mode=OneWay}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE733;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                Command="{x:Bind Actions.ReportPostCommand}"
                                Text="Report post"
                                Visibility="{x:Bind Actions.ShowModeration, Mode=OneWay}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE7C1;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!--  Inline reply box: popped visible right below the post it's replying to. Not
              realized until the first reply on this card (x:Load="False", realized with
              FindName) - a full RichSuggestBox editor per card is by far the heaviest thing a
              card could hold. Shown/hidden from code-behind (see UpdateInlineReplyVisibility)
              rather than x:Bind - see OnComposeStateChanged for why.  -->
        <local:ComposeBox
            x:Name="InlineReply"
            Grid.Row="6"
            Grid.Column="1"
            x:Load="False"
            animations:Implicit.HideAnimations="{StaticResource ImplicitFadeHideAnimations}"
            animations:Implicit.ShowAnimations="{StaticResource ImplicitFadeShowAnimations}"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
