<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Traysky.Controls.EmbedPresenter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:Traysky.Helpers"
    xmlns:items="using:Traysky.ViewModels.Items"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Key="ImageTemplate" x:DataType="items:EmbedImage">
            <Border
                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                CornerRadius="{StaticResource EmbedCornerRadius}"
                ToolTipService.ToolTip="{x:Bind AltText}">
                <Image
                    MaxHeight="220"
                    Stretch="Uniform"
                    Tapped="Image_Tapped"
                    Tag="{x:Bind FullSize}">
                    <Image.Source>
                        <BitmapImage DecodePixelWidth="640" UriSource="{x:Bind Thumbnail}" />
                    </Image.Source>
                </Image>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel x:Name="Root" Spacing="6">

        <!--  Each section below is x:Load'ed rather than collapsed: a card realizes only the one
              layout its embed actually uses, instead of building (and holding) all of them.  -->

        <!--  Images (also the thumbnail of a video)  -->
        <Grid x:Name="ImagesHost" x:Load="{x:Bind Embed.HasImages, Mode=OneWay, FallbackValue=False}">
            <ItemsRepeater x:Name="ImagesRepeater" ItemTemplate="{StaticResource ImageTemplate}" ItemsSource="{x:Bind Embed.Images, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        ItemsStretch="Fill"
                        MinColumnSpacing="4"
                        MinItemWidth="140"
                        MinRowSpacing="4" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>
            <Border
                Width="40"
                Height="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#A0000000"
                CornerRadius="20"
                IsHitTestVisible="False"
                Visibility="{x:Bind Embed.IsVideo, Mode=OneWay}">
                <FontIcon
                    FontSize="16"
                    Foreground="White"
                    Glyph="&#xE768;" />
            </Border>
        </Grid>

        <!--  Link card  -->
        <Border
            x:Name="ExternalCard"
            Style="{StaticResource EmbedCardStyle}"
            x:Load="{x:Bind Embed.IsExternal, Mode=OneWay, FallbackValue=False}"
            Tapped="External_Tapped">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="72"
                    Height="72"
                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                    CornerRadius="8,0,0,8"
                    Visibility="{x:Bind Embed.HasExternalThumbnail, Mode=OneWay}">
                    <Image Stretch="UniformToFill">
                        <Image.Source>
                            <BitmapImage DecodePixelWidth="160" UriSource="{x:Bind Embed.ExternalThumbnail, Mode=OneWay}" />
                        </Image.Source>
                    </Image>
                </Border>
                <StackPanel
                    Grid.Column="1"
                    Margin="0,8,10,8"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <TextBlock
                        Style="{StaticResource SecondaryTextStyle}"
                        Text="{x:Bind Embed.ExternalHost, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        FontWeight="SemiBold"
                        MaxLines="2"
                        Text="{x:Bind Embed.ExternalTitle, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                    <TextBlock
                        MaxLines="2"
                        Style="{StaticResource SecondaryTextStyle}"
                        Text="{x:Bind Embed.ExternalDescription, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind Embed.HasExternalDescription, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  Quoted post  -->
        <Border
            x:Name="QuoteCard"
            Padding="10"
            Style="{StaticResource EmbedCardStyle}"
            x:Load="{x:Bind Embed.HasQuote, Mode=OneWay, FallbackValue=False}"
            Tapped="Quote_Tapped">
            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <PersonPicture
                        Width="{StaticResource SmallAvatarSize}"
                        Height="{StaticResource SmallAvatarSize}"
                        DisplayName="{x:Bind Embed.QuoteAuthorName, Mode=OneWay}"
                        ProfilePicture="{x:Bind helpers:BindHelpers.ImageFromUri(Embed.QuoteAuthorAvatar), Mode=OneWay}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Text="{x:Bind Embed.QuoteAuthorName, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource SecondaryTextStyle}"
                        Text="{x:Bind AtHandle(Embed.QuoteAuthorHandle), Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock
                    FontSize="13"
                    MaxLines="6"
                    Text="{x:Bind Embed.QuoteText, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind Embed.HasQuoteText, Mode=OneWay}" />
                <ItemsRepeater ItemTemplate="{StaticResource ImageTemplate}" ItemsSource="{x:Bind Embed.QuoteImages, Mode=OneWay}" Visibility="{x:Bind Embed.HasQuoteImages, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            ItemsStretch="Fill"
                            MinColumnSpacing="4"
                            MinItemWidth="120"
                            MinRowSpacing="4" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </StackPanel>
        </Border>

        <!--  Deleted / blocked quote  -->
        <Border
            x:Name="UnavailableCard"
            Padding="10"
            x:Load="{x:Bind Embed.IsUnavailable, Mode=OneWay, FallbackValue=False}"
            Style="{StaticResource EmbedCardStyle}">
            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Post unavailable" />
        </Border>
    </StackPanel>
</UserControl>
